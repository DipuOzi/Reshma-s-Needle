# Copy this file to `.env` (or `.env.local`) to customise your local setup.
# Every line is OPTIONAL: with no .env at all the site runs on a built-in
# local database stored in the `.data/` folder.

# --- Database -------------------------------------------------------------
# Use your own PostgreSQL. If it cannot be reached on localhost, the site
# automatically falls back to the built-in local database.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# auto (default) | postgres (never fall back) | embedded (always built-in)
# DB_DRIVER=auto

# Where the built-in database keeps its files (default: ./.data/pglite)
# PGLITE_DATA_DIR=./.data/pglite

# --- Admin dashboard (/admin) ---------------------------------------------
# Access code for the admin dashboard. Default: SAD1999
# ADMIN_ACCESS_CODE=SAD1999

# Long random text used to sign admin login cookies (set this when you put
# the site on the internet).
# ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- GitHub content publishing ----------------------------------------------
# Content is published from the Admin Dashboard straight into this repository
# (content/*.json, data/*.json, public/images/uploads/*). Each publish commit
# triggers a new Vercel deployment. Grant the token "Contents: Read and write"
# permission for this repository only (fine-grained personal access token).
#
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
# GITHUB_OWNER=DipuOzi
# GITHUB_REPO=Reshma-s-Needle
# GITHUB_BRANCH=main
